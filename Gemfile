source "https://rubygems.org"

# Это основной гем, который нужен для GitHub Pages
gem "github-pages", group: :jekyll_plugins

# Плагины, которые вы используете
group :jekyll_plugins do
  gem "jekyll-sitemap"
  gem "jekyll-feed"
  gem "jekyll-seo-tag"
end

# Для работы на Windows
gem "wdm", ">= 0.1.0" if Gem.win_platform?

# Для работы с веб-сервером
gem "webrick"